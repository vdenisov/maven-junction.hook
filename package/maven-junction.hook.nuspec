<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>maven-junction.hook</id>
    <version>1.1.0</version>
    <title>Maven Junction Hook</title>
    <authors>Victor Denisov</authors>
    <licenseUrl>https://github.com/vdenisov/maven-junction.hook/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/vdenisov/maven-junction.hook</projectUrl>
    <packageSourceUrl>https://github.com/vdenisov/maven-junction.hook</packageSourceUrl>
    <docsUrl>https://github.com/vdenisov/maven-junction.hook#readme</docsUrl>
    <bugTrackerUrl>https://github.com/vdenisov/maven-junction.hook/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/vdenisov/maven-junction.hook/releases</releaseNotes>
    <copyright>2026 Victor Denisov</copyright>
    <summary>Keeps a stable directory junction pointing to the Chocolatey-managed Maven installation.</summary>
    <description><![CDATA[Maintains a stable directory junction (`C:\tools\maven` by default) that always points to the current Chocolatey-managed Maven installation. After each Maven install or upgrade the junction is retargeted, so tools like IntelliJ IDEA never need their Maven home path updated.

If Maven is already installed, the junction is created when this package is installed.

## Package Parameters

- `/JunctionPath:PATH` - junction location. Defaults to `<Chocolatey tools location>\maven`. Changing it on reinstall or upgrade moves the junction.

Example: `choco install maven-junction.hook --params "/JunctionPath:'D:\sdk\maven'"`
]]></description>
    <tags>maven junction hook</tags>
    <dependencies>
      <!-- Hooks were introduced in Chocolatey CLI 1.2.0. -->
      <dependency id="chocolatey" version="1.2.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="hook\**" target="hook" />
    <file src="tools\**" target="tools" />
  </files>
</package>
