<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>maven-junction.hook</id>
    <version>1.1.0</version>
    <title>Maven Junction Hook</title>
    <authors>Victor Denisov</authors>
    <licenseUrl>https://github.com/vdenisov/maven-junction.hook/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/vdenisov/maven-junction.hook</projectUrl>
    <description>
      Maintains a stable directory junction (C:\tools\maven by default) that always
      points to the current Chocolatey-managed Maven installation. After each Maven
      install or upgrade the junction is automatically retargeted, so tools like
      IntelliJ IDEA never need their Maven home path updated.

      Package parameters:
      - /JunctionPath:PATH - junction location. Defaults to
        &lt;Chocolatey tools location&gt;\maven.
    </description>
    <tags>maven junction hook</tags>
  </metadata>
  <files>
    <file src="hook\**" target="hook" />
    <file src="tools\**" target="tools" />
  </files>
</package>
